{
  "manifest_version": 3,
  "name": "Padel Booking Leon - Playtomic e Wansport",
  "version": "1.24.0",
  "description": "Wansport: guida alla prenotazione. Playtomic: diagnosi assistita del calendario visibile.",
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leon30071980.github.io/Padel-Booking-Leon/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gunnerspadel.wansport.com/*",
        "https://propadelclub.wansport.com/*",
        "https://puntogpadel.wansport.com/*",
        "https://pgsdonbosco.wansport.com/*",
        "https://circoloinzani.wansport.com/*"
      ],
      "js": [
        "wansport-handoff.js",
        "wansport-booking.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://playtomic.com/clubs/padel-hero-parma*"
      ],
      "js": [
        "playtomic-inspector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ]
}
