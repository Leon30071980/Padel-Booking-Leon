{
  "manifest_version": 3,
  "name": "Padel Booking Leon - Playtomic e Wansport",
  "version": "1.20.0",
  "description": "Disponibilità Playtomic e prenotazione assistita su Pro Padel Wansport con conferma esplicita.",
  "host_permissions": [
    "https://playtomic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leon30071980.github.io/Padel-Booking-Leon/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gunnerspadel.wansport.com/*",
        "https://propadelclub.wansport.com/*",
        "https://puntogpadel.wansport.com/*"
      ],
      "js": [
        "wansport-handoff.js",
        "wansport-booking.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ]
}
